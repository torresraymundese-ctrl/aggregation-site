# 海外 API 中继站生产环境变量样例
# 复制为 .env.production 后填写真实值，不要提交 .env.production。

# Database
POSTGRES_DB=abroad_prod
POSTGRES_USER=overseas_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://overseas_app:CHANGE_ME_DB_PASSWORD@postgres:5432/abroad_prod
DB_MAX_POOL_SIZE=20

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# 正式自动支付回调启用前必须配置至少 32 字符的随机密钥。
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_SECRET

# 只要数据库中存在 BYOK 供应商就必须配置。使用 `openssl rand -base64 32` 生成。
# 该密钥用于 AES-256-GCM 加密供应商 Key，丢失后已有凭据无法恢复。
BYOK_MASTER_KEY_B64=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY

# Admin
ADMIN_EMAILS=admin@example.com

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
TRUST_PROXY_HEADERS=true

# API Providers
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_GOOGLE_API_KEY=
PROVIDER_VOLCENGINE_API_KEY=
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_ZHIPU_API_KEY=
PROVIDER_QWEN_API_KEY=
PROVIDER_MOONSHOT_API_KEY=
PROVIDER_MINIMAX_API_KEY=
PROVIDER_STEPFUN_API_KEY=

# Replicate 异步任务回调公网入口，必须是实际 HTTPS API 根路径。
ASYNC_WEBHOOK_PUBLIC_BASE_URL=https://your-frontend-domain.com/api
ASYNC_TASK_TTL_HOURS=168

# Server
PORT=8080
RUST_ENV=production
LOG_LEVEL=info
