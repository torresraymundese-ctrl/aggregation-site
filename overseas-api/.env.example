# ========================================
# Database - PostgreSQL
# ========================================
# Local: postgresql://user:password@localhost:5432/dbname
# Docker: postgresql://user:password@postgres:5432/dbname
DATABASE_URL=postgresql://app:password@localhost:5432/abroad_dev

# ========================================
# Redis
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# JWT
# ========================================
# Dev: any string
# Prod: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# 自动支付回调未接通时留空，服务会拒绝所有回调；接通后填写至少 32 字符的随机密钥。
PAYMENT_WEBHOOK_SECRET=

# 只要数据库中存在 BYOK 供应商就必须配置。值必须是恰好 32 字节密钥的 Base64。
# 可用 `openssl rand -base64 32` 生成；轮换前必须先重新加密已有供应商凭据。
BYOK_MASTER_KEY_B64=

# ========================================
# Admin
# ========================================
ADMIN_EMAILS=admin@example.com

# ========================================
# CORS
# ========================================
# Dev can use local frontend origins.
# Prod must use the real HTTPS frontend origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5180
TRUST_PROXY_HEADERS=false

# ========================================
# API Providers (海外站用)
# ========================================
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_GOOGLE_API_KEY=
PROVIDER_VOLCENGINE_API_KEY=
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_ZHIPU_API_KEY=
PROVIDER_QWEN_API_KEY=
PROVIDER_MOONSHOT_API_KEY=
PROVIDER_MINIMAX_API_KEY=
PROVIDER_STEPFUN_API_KEY=

# Replicate 异步任务回调公网入口，必须为 HTTPS，且应指向本 API 的外部 /api 根路径。
# 例如：https://openbridgetech.ca/api
ASYNC_WEBHOOK_PUBLIC_BASE_URL=
ASYNC_TASK_TTL_HOURS=168

# ========================================
# Server
# ========================================
PORT=8080
RUST_ENV=development
LOG_LEVEL=info
